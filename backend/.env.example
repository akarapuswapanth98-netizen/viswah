# VISWAH Backend - Environment Variables
# Copy this file to .env and fill in values

# ── Required ──────────────────────────────────────────────────────

# JWT Secret - REQUIRED. The app will not start without it.
# Generate a production secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here

# ── Database ──────────────────────────────────────────────────────

# SQLite (development): sqlite:///./viswah.db
# PostgreSQL (production): postgresql://user:pass@host:5432/viswah
DATABASE_URL=sqlite:///./viswah.db

# ── CORS ──────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI Services (Optional) ───────────────────────────────────────

# OpenAI API Key - Get from https://platform.openai.com/api-keys
# If empty, AI features use deterministic fallback responses
OPENAI_API_KEY=

# ElevenLabs API Key - Get from https://elevenlabs.io
# If empty, Vocal Guru falls back to gTTS
ELEVENLABS_API_KEY=

# ── Razorpay (Optional for development) ───────────────────────────

# Get from https://dashboard.razorpay.com/app/keys
# If empty, checkout uses dev-mode simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
